# Banco de Dados
DATABASE_URL="postgresql://user:password@localhost:5432/controle_db"

# JWT
# Gere um valor aleatório (mín. 32 caracteres), por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# O valor abaixo é apenas um exemplo e é recusado pela aplicação.
JWT_SECRET="troque-por-um-valor-aleatorio"
JWT_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Controlê"

# Email (Resend ou SMTP) - desativado inicialmente
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@controle.app"

# Google OAuth (para implementação futura)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
