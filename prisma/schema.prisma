generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  CREDENTIALS
  GOOGLE
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
  CASH
}

enum SplitStatus {
  PENDING
  PAID
}

enum RecurringFrequency {
  MONTHLY
  ANNUAL
  CUSTOM
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  passwordHash     String?
  avatar           String?
  provider         Provider       @default(CREDENTIALS)
  providerId       String?
  emailVerified    Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  memberships      GroupMember[]
  assignedIncomes  Income[]       @relation("IncomeResponsible")
  assignedExpenses Expense[]      @relation("ExpenseResponsible")
  expenseSplits    ExpenseSplit[]
  sessions         Session[]
  createdGroups    Group[]        @relation("GroupCreator")

  @@index([provider, providerId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Group {
  id                   String        @id @default(cuid())
  name                 String
  description          String?
  inviteToken          String        @unique @default(cuid())
  createdById          String?
  timedInviteToken     String?       @unique
  timedInviteExpiresAt DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            User?         @relation("GroupCreator", fields: [createdById], references: [id])
  members              GroupMember[]
  categories           Category[]
  incomes              Income[]
  expenses             Expense[]
  invites              GroupInvite[]
}

model GroupMember {
  id       String    @id @default(cuid())
  userId   String
  groupId  String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, role])
}

model Category {
  id        String       @id @default(cuid())
  groupId   String
  name      String
  type      CategoryType
  color     String?
  icon      String?
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  incomes   Income[]
  expenses  Expense[]

  @@unique([groupId, name, type])
  @@index([groupId, type])
}

model Income {
  id                 String              @id @default(cuid())
  groupId            String
  responsibleId      String
  categoryId         String?
  amount             Decimal             @db.Decimal(12, 2)
  date               DateTime
  description        String?
  isRecurring        Boolean             @default(false)
  recurringFrequency RecurringFrequency?
  recurringInterval  Int?
  recurringRef       String?
  recurringNum       Int?
  recurringTotal     Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  group              Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  responsible        User                @relation("IncomeResponsible", fields: [responsibleId], references: [id])
  category           Category?           @relation(fields: [categoryId], references: [id])

  @@index([groupId, date])
  @@index([responsibleId])
  @@index([recurringRef])
}

model Expense {
  id                 String              @id @default(cuid())
  groupId            String
  responsibleId      String
  categoryId         String?
  amount             Decimal             @db.Decimal(12, 2)
  date               DateTime
  description        String?
  paymentMethod      PaymentMethod
  installments       Int                 @default(1)
  installmentRef     String?
  installmentNum     Int?
  isRecurring        Boolean             @default(false)
  recurringFrequency RecurringFrequency?
  recurringInterval  Int?
  recurringRef       String?
  recurringNum       Int?
  recurringTotal     Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  group              Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  responsible        User                @relation("ExpenseResponsible", fields: [responsibleId], references: [id])
  category           Category?           @relation(fields: [categoryId], references: [id])
  splits             ExpenseSplit[]

  @@index([groupId, date])
  @@index([installmentRef])
  @@index([responsibleId])
  @@index([recurringRef])
}

model ExpenseSplit {
  id        String      @id @default(cuid())
  expenseId String
  userId    String
  amount    Decimal     @db.Decimal(12, 2)
  status    SplitStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  expense   Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([userId, status])
}

model GroupInvite {
  id        String    @id @default(cuid())
  groupId   String
  email     String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, email])
}
